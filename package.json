{
  "name": "adonis-react-vite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AdonisJS 6 + Vite + React 19 + TypeScript fullstack starter",
  "license": "MIT",
  "repository": "https://github.com/michaelmcshinsky/adonis-react-vite",
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#models/*": "./app/models/*.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node ace serve --hmr",
    "build": "node ace build --production",
    "start": "node server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "migrate": "node ace migration:run",
    "seed": "node ace db:seed"
  },
  "dependencies": {
    "@adonisjs/core": "^6.21.0",
    "@adonisjs/lucid": "^21.8.0",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/view": "^7.0.0-7",
    "@adonisjs/vite": "^4.0.0",
    "@vinejs/vine": "^3.0.1",
    "luxon": "^3.5.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.5.1",
    "@japa/runner": "^5.4.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
