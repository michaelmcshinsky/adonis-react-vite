{
  "name": "adonis-react-vite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AdonisJS 6 + Vite + React 19 + TypeScript fullstack starter",
  "license": "MIT",
  "repository": "https://github.com/michaelmcshinsky/adonis-react-vite",
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#models/*": "./app/models/*.js",
    "#validators/*": "./app/validators/*.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx ace.js serve --hmr",
    "build": "tsx ace.js build",
    "start": "node server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "migrate": "tsx ace.js migration:run",
    "migrate:rollback": "tsx ace.js migration:rollback",
    "seed": "tsx ace.js db:seed",
    "key:generate": "tsx ace.js generate:key"
  },
  "dependencies": {
    "@adonisjs/core": "^6.21.0",
    "@adonisjs/lucid": "^21.8.0",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/view": "^7.0.0-7",
    "@adonisjs/vite": "^4.0.0",
    "@vinejs/vine": "^3.0.1",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@japa/runner": "^5.4.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
